{
  "expo": {
    "name": "Voice Note",
    "slug": "voice-note-drive",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "backgroundColor": "#0a0a0a"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.personal.voicenote",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Microphone access is required to record voice notes.",
        "NSLocationWhenInUseUsageDescription": "Location is saved as metadata in your voice notes."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0a0a0a"
      },
      "package": "com.personal.voicenote",
      "permissions": ["RECORD_AUDIO", "ACCESS_FINE_LOCATION", "ACCESS_COARSE_LOCATION"]
    },
    "plugins": [
      [
        "expo-av",
        {
          "microphonePermission": "Allow Voice Note to record audio."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Location is saved as metadata in your voice notes."
        }
      ]
    ],
    "extra": {
      "googleClientId": ""
    }
  }
}
